# Server Environment Variables Configuration

# Server Environment & Port
PORT=8000
NODE_ENV=development

# Database Connection (MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/uthsonova_blog?retryWrites=true&w=majority

# Authentication Secrets
JWT_SECRET=your_jwt_super_secret_key_change_in_production
JWT_EXPIRES_IN=7d
ADMIN_SECRET_KEY=your_admin_registration_secret_key

# CORS Origin Allowed Client
CLIENT_ORIGIN=http://localhost:5173
# For Production:
# CLIENT_ORIGIN=https://blog-ppwc.vercel.app

# Google Gemini API (AI Writing Assistant)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Cloudinary (Image Uploads & Storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Cron Job Secret (for /api/cron/publish-daily automated blog publishing)
CRON_SECRET=your_secure_cron_secret_token_here
